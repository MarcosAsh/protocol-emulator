# usb, from test/pin_trace.ml: do not edit
# cycles ui_in uio_in uo_out uio_out uio_oe; cycle 0 is the first rising edge
# after rst_n rises, outputs are the values after the edge
# sigrok clock 48000000
# sigrok decoder usb_signalling:dp=IO0:dm=IO1:signalling=low-speed,usb_packet:signalling=low-speed,usb_request
# sigrok annotations usb_packet=packet-setup:packet-in:packet-out:packet-data0:packet-data1:packet-ack:packet-nak
# sigrok expect usb_packet-1: SETUP ADDR 0 EP 0
# sigrok expect usb_packet-1: DATA0 [ 80 06 00 01 00 00 08 00 ]
# sigrok expect usb_packet-1: ACK
# sigrok expect usb_packet-1: IN ADDR 0 EP 0
# sigrok expect usb_packet-1: DATA1 [ 12 01 10 01 00 00 00 08 ]
# sigrok expect usb_packet-1: ACK
# sigrok expect usb_packet-1: OUT ADDR 0 EP 0
# sigrok expect usb_packet-1: DATA1 [ ]
# sigrok expect usb_packet-1: ACK
# sigrok expect usb_packet-1: IN ADDR 0 EP 1
# sigrok expect usb_packet-1: DATA0 [ 01 00 0B 00 00 00 00 00 ]
# sigrok expect usb_packet-1: ACK
# sigrok expect usb_packet-1: IN ADDR 0 EP 1
# sigrok expect usb_packet-1: NAK
# sigrok annotations usb_request
# sigrok expect usb_request-1: SETUP in: [ 80 06 00 01 00 00 08 00 ][ 12 01 10 01 00 00 00 08 ] : ACK
# sigrok expect usb_request-1: BULK in: [ 01 00 0B 00 00 00 00 00 ] : ACK
# sigrok tooth flip:IO0:152:46:32 flip:IO1:156:46:32
