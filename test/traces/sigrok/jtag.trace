# jtag, from test/pin_trace.ml: do not edit
# cycles ui_in uio_in uo_out uio_out uio_oe; cycle 0 is the first rising edge
# after rst_n rises, outputs are the values after the edge
# sigrok clock 50000000
# sigrok decoder jtag:tdi=OUT1:tdo=IN0:tck=OUT0:tms=OUT2
# sigrok annotations jtag=bitstring-tdi
# sigrok expect jtag-1: DR TDI: 00000000000000000000000000000000 (0x0), 32 bits
# sigrok expect jtag-1: IR TDI: 0010 (0x2), 4 bits
# sigrok expect jtag-1: DR TDI: 10100101 (0xa5), 8 bits
# sigrok expect jtag-1: DR TDI: 00111100 (0x3c), 8 bits
# sigrok annotations jtag=bitstring-tdo
# sigrok expect jtag-1: DR TDO: 01001011101000000000010001110111 (0x4ba00477), 32 bits
# sigrok expect jtag-1: IR TDO: 0001 (0x1), 4 bits
# sigrok expect jtag-1: DR TDO: 00000000 (0x0), 8 bits
# sigrok expect jtag-1: DR TDO: 10100101 (0xa5), 8 bits
# sigrok tooth flip:IN0:0:0:8
