# spi_mode1, from test/pin_trace.ml: do not edit
# cycles ui_in uio_in uo_out uio_out uio_oe; cycle 0 is the first rising edge
# after rst_n rises, outputs are the values after the edge
# sigrok clock 48000000
# sigrok decoder spi:cs=OUT2:clk=OUT1:mosi=OUT0:miso=IN0:cpol=0:cpha=1
# sigrok annotations spi=mosi-transfer
