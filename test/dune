(library
 (name protocol_emulator_test)
 (libraries
  core
  hardcaml
  protocol_emulator
  hardcaml_test_harness
  hardcaml_waveterm
  expect_test_helpers_core
  hardcaml_verify
  re
  hardcaml_hobby_boards
  ppxlib
  ppx_firmware)
 (lint
  (pps ppx_js_style -check-doc-comments))
 (preprocess
  (pps ppx_hardcaml ppx_jane ppx_firmware))
 (inline_tests
  (deps
   (glob_files *.ml)
   (glob_files *.asm)
   (glob_files assemble/*.asm)
   (glob_files *.hex)
   (glob_files diagrams/*.json)
   (glob_files learn/*.edges)
   (source_tree board)
   ../formal/Makefile
   ../src/protocol_emulator.v
   ../python/demo_board.py
   ../icepi/Makefile)
  (flags
   (-source-tree-root .))))

; Hardcaml's cyclesim coverage of src/ over every test above, checked against
; coverage_triage.txt: dune build @test/coverage. It reruns the tests, so it is apart from
; runtest; the reports are left in coverage/ beside the runner. CI builds
; @test/coverage_reports in shards and checks them together.

(rule
 (alias coverage_reports)
 (deps
  (env_var COVERAGE_SHARD)
  (glob_files *.asm)
  (glob_files assemble/*.asm)
  (glob_files *.hex)
  (glob_files diagrams/*.json)
  (glob_files ../src/*.ml)
  ../formal/Makefile
  ../src/protocol_emulator.v
  ../python/demo_board.py
  ../icepi/Makefile)
 (action
  (run
   sh
   %{dep:coverage.sh}
   %{dep:.protocol_emulator_test.inline-tests/inline-test-runner.exe})))

(rule
 (alias coverage)
 (deps
  (alias coverage_reports)
  (glob_files ../src/*.ml))
 (action
  (run python3 %{dep:check_coverage.py} %{dep:coverage_triage.txt} coverage)))
