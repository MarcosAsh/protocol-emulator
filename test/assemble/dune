; The command line on a source file: the verdicts go to stderr, and firmware that the
; analyser finds can miss a deadline, or whose rows the kernel does not accept, leaves no
; words and a failing exit code.

(rule
 (with-outputs-to
  uart_tx.gen
  (run %{exe:../../bin/generate.exe} assemble %{dep:../uart_tx.asm})))

(rule
 (alias runtest)
 (action
  (diff uart_tx.expected uart_tx.gen)))

(rule
 (with-outputs-to
  too_tight.gen
  (with-accepted-exit-codes
   1
   (run %{exe:../../bin/generate.exe} assemble %{dep:too_tight.asm}))))

(rule
 (alias runtest)
 (action
  (diff too_tight.expected too_tight.gen)))

(rule
 (with-outputs-to
  too_tight_unchecked.gen
  (run
   %{exe:../../bin/generate.exe}
   assemble
   -no-timing-check
   %{dep:too_tight.asm})))

(rule
 (alias runtest)
 (action
  (diff too_tight_unchecked.expected too_tight_unchecked.gen)))

(rule
 (with-outputs-to
  ws2812_waiting_after_gap.gen
  (run
   %{exe:../../bin/generate.exe}
   assemble
   %{dep:ws2812_waiting_after_gap.asm})))

(rule
 (alias runtest)
 (action
  (diff ws2812_waiting_after_gap.expected ws2812_waiting_after_gap.gen)))

(rule
 (with-outputs-to
  gap_adding_x.gen
  (with-accepted-exit-codes
   1
   (run %{exe:../../bin/generate.exe} assemble %{dep:gap_adding_x.asm}))))

(rule
 (alias runtest)
 (action
  (diff gap_adding_x.expected gap_adding_x.gen)))

(rule
 (with-outputs-to
  wrapped_loop.gen
  (run
   %{exe:../../bin/generate.exe}
   assemble
   -listing
   %{dep:../wrapped_loop.asm})))

(rule
 (alias runtest)
 (action
  (diff wrapped_loop.expected wrapped_loop.gen)))

; the rows the overlay in demo/ reads the proved edges from

(rule
 (with-stdout-to
  uart_tx_rows.gen
  (run %{exe:../../bin/generate.exe} assemble -rows %{dep:../uart_tx.asm})))

(rule
 (alias runtest)
 (action
  (diff uart_tx_rows.expected uart_tx_rows.gen)))
