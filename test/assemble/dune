; the rows the overlay in demo/ reads the proved edges from

(rule
 (with-stdout-to
  uart_tx_rows.gen
  (run %{exe:../../bin/generate.exe} assemble -rows %{dep:../uart_tx.asm})))

(rule
 (alias runtest)
 (action
  (diff uart_tx_rows.expected uart_tx_rows.gen)))

; The predicate compiler's firmware and settings are the watch cocotb runs, and a latency
; one cycle short is refused.

(rule
 (targets i2c_start_watch.gen i2c_start_watch.settings.gen)
 (action
  (with-stdout-to
   i2c_start_watch.gen
   (run
    %{exe:../../bin/generate.exe}
    predicate
    -latency
    10
    -settings
    i2c_start_watch.settings.gen
    "pin 0 falls while pin 1 is high"))))

(rule
 (alias runtest)
 (action
  (diff ../i2c_start_watch.asm i2c_start_watch.gen)))

(rule
 (alias runtest)
 (action
  (diff ../i2c_start_watch.settings i2c_start_watch.settings.gen)))

(rule
 (with-outputs-to
  i2c_start_short.gen
  (with-accepted-exit-codes
   1
   (run
    %{exe:../../bin/generate.exe}
    predicate
    -latency
    5
    "pin 0 falls while pin 1 is high"))))

(rule
 (alias runtest)
 (action
  (diff i2c_start_short.expected i2c_start_short.gen)))

(rule
 (targets quiet_watch.gen quiet_watch.settings.gen)
 (action
  (with-stdout-to
   quiet_watch.gen
   (run
    %{exe:../../bin/generate.exe}
    predicate
    -latency
    20
    -settings
    quiet_watch.settings.gen
    "pin 2 stops moving"))))

(rule
 (alias runtest)
 (action
  (diff ../quiet_watch.asm quiet_watch.gen)))

(rule
 (alias runtest)
 (action
  (diff ../quiet_watch.settings quiet_watch.settings.gen)))

; a latency whose budget is too long for set, so the host sends it

