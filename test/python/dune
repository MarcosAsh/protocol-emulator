(executables
 (names
  write_usb_firmware
  write_ethernet_firmware
  write_certified_firmware
  write_sweep_firmware
  write_kernel_variants
  write_glitch_images
  write_bench_firmware
  write_both_roles_firmware
  write_tolerance_firmware)
 (libraries core hardcaml protocol_emulator protocol_emulator_test)
 (preprocess
  (pps ppx_jane)))

(rule
 (with-stdout-to
  usb_device_firmware.py.gen
  (run ./write_usb_firmware.exe)))

(rule
 (alias runtest)
 (action
  (diff ../../python/usb_device_firmware.py usb_device_firmware.py.gen)))

