(executables
 (names write_usb_firmware write_ethernet_firmware write_certified_firmware)
 (libraries core hardcaml protocol_emulator protocol_emulator_test)
 (preprocess
  (pps ppx_jane)))

(rule
 (with-stdout-to
  usb_device_firmware.py.gen
  (run ./write_usb_firmware.exe)))

(rule
 (alias runtest)
 (action
  (diff ../../python/usb_device_firmware.py usb_device_firmware.py.gen)))

(rule
 (with-stdout-to
  ethernet_firmware.py.gen
  (run ./write_ethernet_firmware.exe)))

(rule
 (alias runtest)
 (action
  (diff ../../python/ethernet_firmware.py ethernet_firmware.py.gen)))

(rule
 (with-stdout-to
  certified_firmware.py.gen
  (run ./write_certified_firmware.exe)))

(rule
 (alias runtest)
 (action
  (diff ../../python/certified_firmware.py certified_firmware.py.gen)))

(rule
 (alias runtest)
 (deps ../../python/protocol_emulator.py)
 (action
  (run python3 -B %{dep:test_host.py} ../../python)))
