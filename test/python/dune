; the predictions are sealed: a change to them is a change to the pin

(rule
 (alias runtest)
 (deps ../../python/clock_cliffs.py ../clock_cliffs.sha256)
 (action
  (chdir
   ../..
   (run sha256sum --check --quiet test/clock_cliffs.sha256))))

(rule
 (alias runtest)
 (deps
  ../../demo/clock_sweep.py
