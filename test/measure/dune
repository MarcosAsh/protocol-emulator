; the predictions test/test_margins.py holds made captures to

(rule
 (with-stdout-to
  uart_tx_115200.predicted.gen
  (run ./predict.exe uart_tx_115200)))

(rule
 (alias runtest)
 (action
  (diff uart_tx_115200.predicted uart_tx_115200.predicted.gen)))

