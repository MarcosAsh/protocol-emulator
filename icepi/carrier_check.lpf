# carrier_check.v's pulls on top of header.lpf: OUT0-OUT6 down like every other pin it
# tests, so a pin nothing drives reads 0 and a pull-up reads 1.

IOBUF PORT "uo[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[5]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[6]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
IOBUF PORT "uo[7]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
