# Pins every revision shares. The header's balls only differ at pin 16, left unused. USB is
# the first USB-C port (J3 on v1.4); G15/H14 are its pull pins from v1.2, unconnected before.

LOCATE COMP "button_n" SITE "C4";
IOBUF PORT "button_n" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "ui[0]" SITE "G2"; # header 23
IOBUF PORT "ui[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[1]" SITE "L2"; # header 19
IOBUF PORT "ui[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[2]" SITE "H2"; # header 24
IOBUF PORT "ui[2]" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ui[3]" SITE "T2"; # header 3
IOBUF PORT "ui[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[4]" SITE "R2"; # header 5
IOBUF PORT "ui[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[5]" SITE "R1"; # header 7
IOBUF PORT "ui[5]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[6]" SITE "R3"; # header 11
IOBUF PORT "ui[6]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "ui[7]" SITE "P3"; # header 13
IOBUF PORT "ui[7]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uo[0]" SITE "J1"; # header 21
IOBUF PORT "uo[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[1]" SITE "P1"; # header 8
IOBUF PORT "uo[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[2]" SITE "N1"; # header 10
IOBUF PORT "uo[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[3]" SITE "N4"; # header 12
IOBUF PORT "uo[3]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[4]" SITE "L1"; # header 18
IOBUF PORT "uo[4]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[5]" SITE "J2"; # header 22
IOBUF PORT "uo[5]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[6]" SITE "G1"; # header 26
IOBUF PORT "uo[6]" IO_TYPE=LVCMOS33;
LOCATE COMP "uo[7]" SITE "K3"; # header 28
IOBUF PORT "uo[7]" IO_TYPE=LVCMOS33;
LOCATE COMP "uio[0]" SITE "E1"; # header 29
IOBUF PORT "uio[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[1]" SITE "F3"; # header 31
IOBUF PORT "uio[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
# I2C is SCL on IO2 and SDA on IO3, as on Tiny Tapeout's I2C Pmod; the bench has SDA on
# header 33 and SCL on 35, so the two cross here
LOCATE COMP "uio[2]" SITE "E4"; # header 35
IOBUF PORT "uio[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[3]" SITE "E3"; # header 33
IOBUF PORT "uio[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[4]" SITE "D4"; # header 37
IOBUF PORT "uio[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[5]" SITE "H3"; # header 36
IOBUF PORT "uio[5]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[6]" SITE "F1"; # header 38
IOBUF PORT "uio[6]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "uio[7]" SITE "F2"; # header 40
IOBUF PORT "uio[7]" IO_TYPE=LVCMOS33 PULLMODE=DOWN;
LOCATE COMP "usb_detach" SITE "P2"; # header 15
IOBUF PORT "usb_detach" IO_TYPE=LVCMOS33 PULLMODE=DOWN;

LOCATE COMP "usb_dp" SITE "F15";
IOBUF PORT "usb_dp" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
LOCATE COMP "usb_dn" SITE "E16";
IOBUF PORT "usb_dn" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
LOCATE COMP "usb_pull_dp" SITE "G15";
IOBUF PORT "usb_pull_dp" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
LOCATE COMP "usb_pull_dn" SITE "H14";
IOBUF PORT "usb_pull_dn" IO_TYPE=LVCMOS33 DRIVE=4 PULLMODE=NONE;
