; Needs js_of_ocaml, which the locked switch lacks: PLAYGROUND=yes dune build @playground/page

(executable
 (name playground)
 (modes js)
 (modules playground example pio_example)
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (libraries core js_of_ocaml playground_checks protocol_emulator)
 (lint
  (pps ppx_js_style -check-doc-comments))
 (preprocess
  (pps ppx_jane)))

(rule
 (with-stdout-to
  example.ml
  (progn
   (echo "let all =\n  [ \"uart_tx\", {|")
   (cat %{dep:../test/uart_tx.asm})
   (echo "|}\n  ; \"uart_rx_wire\", {|")
   (cat %{dep:../test/uart_rx_wire.asm})
   (echo "|}\n  ; \"i2c_master_marked\", {|")
   (cat %{dep:../test/i2c_master_marked.asm})
   (echo "|}\n  ; \"gap_adding_x\", {|")
   (cat %{dep:gap_adding_x.asm})
   (echo "|}\n  ]\n"))))

(rule
 (with-stdout-to
  pio_example.ml
  (progn
   (echo "let all =\n  [ \"i2c (#796)\", {|")
   (cat %{dep:../pio/test/pico_examples/i2c.pio})
   (echo "|}, {|")
   (cat %{dep:i2c.spec})
   (echo "|}\n  ]\n"))))

(alias
 (name page)
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (deps index.html playground.bc.js))

; The remote lab's page, which the pages workflow does not publish: PLAYGROUND=yes dune
; build @playground/lab, then open _build/default/playground/lab.html

(alias
 (name lab)
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (deps lab.html playground.bc.js))

(library
 (name playground_checks)
 (modules checks diagram_example isa_view)
 (libraries core pio protocol_emulator)
 (lint
  (pps ppx_js_style -check-doc-comments))
 (preprocess
  (pps ppx_jane)))

; each library diagram, and frames of bits to send, a line a frame: host bits, or a
; receiver's peer's

(rule
 (with-stdout-to
  diagram_example.ml
  (progn
   (echo "let all =\n  [ \"uart_tx\", {|")
   (cat %{dep:../test/diagrams/uart_tx.json})
   (echo "|}, \"11000101\\n00111010\"\n  ; \"dshot\", {|")
   (cat %{dep:../test/diagrams/dshot.json})
   (echo
    "|}, \"1000001011000110\\n0000011000000110\"\n  ; \"spi_master\", {|")
   (cat %{dep:../test/diagrams/spi_master.json})
   (echo "|}, \"10100101\\n00111100\"\n  ; \"ws2812\", {|")
   (cat %{dep:../test/diagrams/ws2812.json})
   (echo
    "|}, \"000100001111111100000000\\n100000000000000110101010\"\n  ; \"uart_rx\", {|")
   (cat %{dep:../test/diagrams/uart_rx.json})
   (echo "|}, \"11000101\\n00111010\"\n  ]\n"))))

; Each library firmware through the page and generate.exe, and each diagram at 48 and 50
; MHz through the page and a native build, byte for byte:
; PLAYGROUND=yes dune build @playground/agree

(executable
 (name reference)
 (modules reference)
 (libraries core protocol_emulator protocol_emulator_test playground_checks)
 (lint
  (pps ppx_js_style -check-doc-comments))
 (preprocess
  (pps ppx_jane)))

(rule
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (deps
  (glob_files ../test/diagrams/*.json))
 (action
  (with-stdout-to
   corpus.json
   (run ./reference.exe %{deps}))))

(rule
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (targets native.txt browser.txt)
 (action
  (run
   node
   %{dep:agree.js}
   %{dep:playground.bc.js}
   %{dep:../bin/generate.exe}
   %{dep:corpus.json})))

(rule
 (alias agree)
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (action
  (diff native.txt browser.txt)))

; test/lab's jobs through the page, against the files generate.exe lab wrote for them

(rule
 (alias agree)
 (enabled_if
  (= %{env:PLAYGROUND=no} yes))
 (deps
  (glob_files ../test/lab/*.job.json)
  (source_tree ../test/lab))
 (action
  (run node %{dep:lab_agree.js} %{dep:playground.bc.js} ../test/lab)))
