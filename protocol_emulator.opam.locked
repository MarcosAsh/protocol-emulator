opam-version: "2.0"
name: "protocol_emulator"
version: "dev"
synopsis: "Programmable protocol emulator for Tiny Tapeout"
description: """\
A small core that bit-bangs pins with cycle-exact timing, so serial protocols
are firmware rather than fixed logic. Written in Hardcaml."""
maintainer: "Marcos Ashton"
authors: "Marcos Ashton"
license: "Apache-2.0"
homepage: "https://github.com/MarcosAsh/protocol-emulator"
bug-reports: "https://github.com/MarcosAsh/protocol-emulator/issues"
