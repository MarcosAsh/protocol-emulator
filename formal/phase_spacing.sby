# The pair's spacing for any program and any table of intervals the kernel accepts with a
# spacing. It assumes what phase_step.sby (the step lemma, the pair's ghost),
# phase_table.sby (the one-run theorem, as a table accepted with a spacing is accepted
# without it) and pair_step.sby (the rows carry the pair) prove; left is that the core's
# edges stay in the rows' bounds, and so each counted edge is spaced.
[tasks]
prove
cover
no_spacing teeth

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 24
teeth: mode bmc
teeth: depth 24
teeth: expect fail

[engines]
smtbmc boolector

[script]
read_verilog engine.v
hierarchy -top engine
proc
flatten
cd engine
expose w:jmp_go w:advance w:sample w:captured w:out_value w:mov_value
rename jmp_go eng_jmp_go
rename advance eng_advance
rename sample eng_sample
rename captured eng_captured
rename out_value eng_out_value
rename mov_value eng_mov_value
cd ..
read -define TABLE
read -define SPACING
no_spacing: read -define NO_SPACING
read_verilog kernel_step.v
read_verilog kernel_accepts.v
read_verilog -formal -sv pair_step.sv
read_verilog -formal -sv phase_step.sv
prep -flatten -top phase_step
chformal -assert2assume c:* c:edges_* c:spacing_* %u %d
# the tooth has to space an edge short
teeth: chformal -assert -remove c:edges_*

[files]
engine.v
kernel_step.v
kernel_accepts.v
pair_step.sv
phase_step.sv
