[tasks]
prove
cover
jump_in_one teeth
delay_ignores_side_set teeth
waits_are_plain teeth
write_while_running teeth

[options]
prove: mode prove
prove: depth 6
cover: mode cover
cover: depth 8
teeth: mode bmc
teeth: depth 8
teeth: expect fail

[engines]
smtbmc boolector

[script]
read -formal engine.v
hierarchy -top engine_top
proc
flatten
cd engine_top
expose w:solo.engine.program_memory.write
rename solo.engine.program_memory.write program_memory_write
cd ..
jump_in_one: read -define JUMP_IN_ONE
delay_ignores_side_set: read -define DELAY_IGNORES_SIDE_SET
waits_are_plain: read -define WAITS_ARE_PLAIN
read -formal -sv issue_timing.sv
prep -top issue_timing

[files]
~write_while_running: engine.v
write_while_running: engine.v issue_timing_teeth/write_while_running.v
issue_timing.sv
