[tasks]
prove
teeth
# only for a certificate written with -stamped, whose departure times they break
off_by_one
next_bit

[options]
mode prove
depth 20
# a false claim fails the induction step with no trace from reset: sby says unknown
teeth: expect fail,unknown
off_by_one: expect fail
next_bit: expect fail,unknown

[engines]
smtbmc boolector

[script]
read_verilog -lib RM_IHPSG13_1P_512x16_c2_bm_bist.v
read_verilog engine_sram.v
hierarchy -top engine_top
proc
flatten
expose -evert -sep __ engine_top/t:RM_IHPSG13_1P_512x16_c2_bm_bist
cd engine_top
# induction starts from no history, so it needs the core's own issue and jump
expose w:solo.engine.issue w:solo.engine.jmp_go
rename solo.engine.issue eng_issue
rename solo.engine.jmp_go eng_jmp_go
rename solo.engine.sram_macro.sram__A_ADDR sram_addr
rename solo.engine.sram_macro.sram__A_DOUT sram_dout
rename solo.data_memory.sram_macro.sram__A_DOUT data_sram_dout
cd ..
prove: read_verilog -formal -sv certificate.sv
teeth: read_verilog -formal -sv -DTEETH certificate.sv
off_by_one: read_verilog -formal -sv -DOFF_BY_ONE certificate.sv
next_bit: read_verilog -formal -sv -DNEXT_BIT certificate.sv
prep -top certificate
# as a memory, the harness rom is state induction starts anywhere; as logic it is fixed
memory_map

[files]
engine_sram.v
certificate.sv
../src/RM_IHPSG13_1P_512x16_c2_bm_bist.v
