[tasks]
prove
cover
short_cover
sticky teeth
lend_busy teeth
no_abort teeth
overwrite teeth
overrun teeth
frame_ungated teeth
frame_any_turn teeth
premises_live teeth

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 40
short_cover: mode cover
short_cover: depth 48
teeth: mode bmc
teeth: depth 40
lend_busy: depth 64
overrun: depth 40
teeth: expect fail

[engines]
smtbmc boolector

[script]
read_verilog -lib RM_IHPSG13_1P_512x16_c2_bm_bist.v
prove: read_verilog engines_gated.v
cover: read_verilog turn.v
short_cover: read_verilog short.v
sticky: read_verilog sticky.v
lend_busy: read_verilog lend_busy.v
no_abort: read_verilog no_abort.v
overwrite: read_verilog overwrite.v
overrun: read_verilog overrun.v
frame_ungated: read_verilog frame_ungated.v
frame_any_turn: read_verilog frame_any_turn.v
premises_live: read_verilog premises_live.v
hierarchy -top engines_top
proc
flatten
expose -evert -sep __ engines_top/t:RM_IHPSG13_1P_512x16_c2_bm_bist
cd engines_top
expose w:engines.certified$0 w:engines.certified$1 w:engines.go w:engines.chosen
expose w:engines.checked w:engines.checking w:engines.accepts w:engines.lent$0 w:engines.lent$1
expose w:engines.turn_starts
expose w:engines.engine_0.start w:engines.engine_1.start
expose w:engines.engine_0.free w:engines.engine_1.free w:engines.frame_writes
rename engines.certified$0 certified_0
rename engines.certified$1 certified_1
rename engines.go go
rename engines.chosen chosen
rename engines.checked checked
rename engines.checking checking
rename engines.accepts accepts
rename engines.turn_starts turn_starts
rename engines.lent$0 lent_0
rename engines.lent$1 lent_1
rename engines.engine_0.start started_0
rename engines.engine_1.start started_1
rename engines.engine_0.free free_0
rename engines.engine_1.free free_1
rename engines.frame_writes frame_write
expose w:engines.host_writes
rename engines.host_writes host_writes
expose w:engines.data_memory.turn w:engines.data_memory.keeps$0 w:engines.data_memory.keeps$1
rename engines.data_memory.turn data_turn
rename engines.data_memory.keeps$0 keeps_0
rename engines.data_memory.keeps$1 keeps_1
expose w:engines.data_memory.write w:engines.data_memory.write_addr
rename engines.data_memory.write port_write
rename engines.data_memory.write_addr port_addr
expose w:engines.load_checker.read_valid w:engines.load_checker.read_at
rename engines.load_checker.read_valid walk_reads
rename engines.load_checker.read_at walk_read_at
expose w:engines.load_checker.span w:engines.load_checker.setup$base_0
rename engines.load_checker.span walk_span
rename engines.load_checker.setup$base_0 walk_base
expose w:engines.load_checker.setup$loaded$valid_0 w:engines.load_checker.setup$loaded$value_0
expose w:engines.load_checker.setup$floor_0 w:engines.load_checker.setup$single_edge_0
rename engines.load_checker.setup$loaded$valid_0 walk_valid
rename engines.load_checker.setup$loaded$value_0 walk_value
rename engines.load_checker.setup$floor_0 walk_floor
rename engines.load_checker.setup$single_edge_0 walk_single_edge
expose w:engines.engine_0.premises$period$valid w:engines.engine_0.premises$period$value
expose w:engines.engine_0.premises$floor w:engines.engine_0.premises$single_edge
rename engines.engine_0.premises$period$valid premises_valid_0
rename engines.engine_0.premises$period$value premises_value_0
rename engines.engine_0.premises$floor premises_floor_0
rename engines.engine_0.premises$single_edge premises_single_edge_0
expose w:engines.engine_1.premises$period$valid w:engines.engine_1.premises$period$value
expose w:engines.engine_1.premises$floor w:engines.engine_1.premises$single_edge
rename engines.engine_1.premises$period$valid premises_valid_1
rename engines.engine_1.premises$period$value premises_value_1
rename engines.engine_1.premises$floor premises_floor_1
rename engines.engine_1.premises$single_edge premises_single_edge_1
cd ..
short_cover: read -define SHORT_WALK
teeth: read -define NO_INVARIANT
read_verilog -formal -sv gate.sv
prep -top gate
setundef -undriven -anyseq

[files]
engines_gated.v
gate_teeth/turn.v
gate_teeth/short.v
gate_teeth/sticky.v
gate_teeth/lend_busy.v
gate_teeth/no_abort.v
gate_teeth/overwrite.v
gate_teeth/overrun.v
gate_teeth/frame_ungated.v
gate_teeth/frame_any_turn.v
gate_teeth/premises_live.v
../src/RM_IHPSG13_1P_512x16_c2_bm_bist.v
gate.sv
