[tasks]
prove
cover
wrong_way teeth
off_by_one teeth
stale_word teeth

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 12
teeth: mode bmc
teeth: depth 12
teeth: expect fail

[engines]
smtbmc boolector

[script]
read_verilog engine.v
hierarchy -top engine
proc
flatten
cd engine
expose w:out_value w:tx.head w:tx.empty w:data_moved
rename out_value eng_out_value
rename tx.head eng_tx_head
rename tx.empty eng_tx_empty
rename data_moved eng_data_moved
cd ..
wrong_way: read -define WRONG_WAY
off_by_one: read -define OFF_BY_ONE
stale_word: read -define STALE_WORD
read_verilog osr_step.v
read_verilog -formal -sv data_step.sv
prep -top data_step

[files]
engine.v
osr_step.v
data_step.sv
