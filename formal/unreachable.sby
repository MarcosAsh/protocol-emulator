[tasks]
prove
cover
one_more teeth

[options]
prove: mode prove
prove: depth 2
cover: mode cover
cover: depth 12
teeth: mode bmc
teeth: depth 12
teeth: expect fail

[engines]
smtbmc boolector

[script]
read -formal engine.v
one_more: read -define ONE_MORE
read -formal -sv unreachable.sv
prep -top unreachable

[files]
engine.v
unreachable.sv
