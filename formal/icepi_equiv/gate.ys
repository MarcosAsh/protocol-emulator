# The implementation side: synth_ecp5's netlist, netlist.json in the Makefile's work
# directory, through yosys's own models of the ECP5 cells and DP16KD.v for the block RAM,
# the pads, the PLL and the macro cores cut as in gold.ys; each block RAM's core takes the
# name of the macro's in the RTL. The distributed RAMs, the fifos', become flops.

# the netlist's top alone, none of the cell definitions the JSON carries with it
read_json netlist.json
design -stash netlist

read_verilog -lib +/lattice/cells_bb_ecp5.v
read_verilog -overwrite +/lattice/common_sim.vh +/lattice/ccu2c_sim.vh
read_verilog -lib -overwrite ../icepi_equiv/pads.v
read_verilog -lib ../icepi_equiv/sram_core.v
read_verilog -defer ../icepi_equiv/DP16KD.v
design -copy-from netlist icepi_top
# the cells the models cover, and no other; three block RAMs, one PLL, the twelve pads
select -assert-none icepi_top/t:* t:LUT4 t:L6MUX21 t:PFUMX t:CCU2C t:TRELLIS_FF %u %u %u %u \
  t:TRELLIS_DPR16X4 t:DP16KD t:TRELLIS_IO t:EHXPLLL %u %u %u %u %d
select -assert-count 3 icepi_top/t:DP16KD
select -assert-count 1 icepi_top/t:EHXPLLL
select -assert-count 12 icepi_top/t:TRELLIS_IO
hierarchy -check -top icepi_top
cd icepi_top
rename chip.core.top.engines.data_memory.sram_macro.sram.i_SRAM_1P_behavioral_bm_bist.memory.0.0 \
  chip.core.top.engines.data_memory.sram_macro.sram
rename chip.core.top.engines.engine_0.sram_macro.sram.i_SRAM_1P_behavioral_bm_bist.memory.0.0 \
  chip.core.top.engines.engine_0.sram_macro.sram
rename chip.core.top.engines.engine_1.sram_macro.sram.i_SRAM_1P_behavioral_bm_bist.memory.0.0 \
  chip.core.top.engines.engine_1.sram_macro.sram
cd ..
proc
flatten
memory_collect
memory_map
opt_clean
delete t:$scopeinfo
select -assert-count 3 t:sram_core
expose -evert t:TRELLIS_IO t:EHXPLLL t:sram_core
# a pad is its pins I, T and O; the pin itself, B, and the top's ports on it go
delete -port icepi_top/uio icepi_top/usb_dp icepi_top/usb_dn icepi_top/usb_pull_dp icepi_top/usb_pull_dn
delete -port icepi_top/*.B
opt_clean

# one clock: every flop takes the rising edge of the PLL's CLKOS, but Both_edges' falling
# pair, whose CLKMUX=INV the cell model reads as the falling edge of it
select -assert-none t:$*latch* t:$sr %u
select -assert-none t:$*ff* w:pll.CLKOS %co:+[CLK] %d
select -set falling w:chip.core.top.both_edges.signal_reg \
  w:chip.core.top.both_edges.signal_reg_1 %u %ci6:+[Q] t:$*ff* %i
select -assert-count 2 @falling
select -assert-count 2 @falling r:CLK_POLARITY=0 r:CLK_POLARITY=1'0 %u %i
select -assert-none t:$*ff* r:CLK_POLARITY=1 r:CLK_POLARITY=1'1 %u %d @falling %d

# no used net without a driver, which miter -flatten would make an x
check -assert

rename icepi_top gate
hierarchy -top gate
delete =A:blackbox
write_rtlil gate.il
