# The reference side: icepi/icepi_top.v around src/project.v and written.v, the copy of
# src/protocol_emulator.v the Makefile makes so a tooth can mutate it, the SRAM macros
# IHP's model of them, as icepi/Makefile reads them, with params.ys's USB and MHZ. The
# chip as written: each flop of a state machine synth_ecp5 recodes matches its binary
# state compared with one value (miter.ys). The pads become the ECP5's as synth_ecp5 maps
# them, and the pads, the PLL and the macros' cores (SRAM_1P_behavioral_bm_bist) are cut.
# The fifos' memories become flops.

read_verilog -DFUNCTIONAL ../../icepi/icepi_top.v ../../src/project.v written.v \
  ../../test/models/RM_IHPSG13_1P_512x16_c2_bm_bist.v \
  ../../test/models/RM_IHPSG13_1P_core_behavioral_bm_bist.v
read_verilog -lib +/lattice/cells_bb_ecp5.v +/lattice/cells_io.vh ../icepi_equiv/pads.v
script params.ys
hierarchy -check -top icepi_top
blackbox =*SRAM_1P_behavioral_bm_bist
proc

flatten
techmap -map +/lattice/cells_io.vh t:BB t:OBZ
memory_collect
memory_map
opt_expr -mux_undef
opt_clean
delete t:$scopeinfo
select -assert-count 3 t:*SRAM_1P_behavioral_bm_bist
expose -evert t:TRELLIS_IO t:EHXPLLL t:*SRAM_1P_behavioral_bm_bist
# a pad is its pins I, T and O; the pin itself, B, and the top's ports on it go
delete -port icepi_top/uio icepi_top/usb_dp icepi_top/usb_dn icepi_top/usb_pull_dp icepi_top/usb_pull_dn
delete -port icepi_top/*.B
opt_clean

# one clock: every flop takes the rising edge of the PLL's CLKOS, but Both_edges' falling
# pair, which takes its falling edge; in the AIG both sides' pairs step with the others,
# so they are compared as flops of the one clock, as gate.ys has them behind inverters
select -assert-none t:$*latch* t:$sr %u
select -assert-none t:$*ff* w:pll.CLKOS %co:+[CLK] %d
select -set falling w:chip.core.top.both_edges.signal_reg \
  w:chip.core.top.both_edges.signal_reg_1 %u %ci6:+[Q] t:$*ff* %i
select -assert-count 2 @falling
select -assert-count 2 @falling r:CLK_POLARITY=0 r:CLK_POLARITY=1'0 %u %i
select -assert-none t:$*ff* r:CLK_POLARITY=1 r:CLK_POLARITY=1'1 %u %d @falling %d

# no used net without a driver, which miter -flatten would make an x
check -assert

rename icepi_top gold
hierarchy -top gold
delete =A:blackbox
write_rtlil gold.il
