[tasks]
prove
cover
jump_in_one teeth
late_wait_waits teeth
no_carry teeth
one_late_cycle_is_safe teeth
taken_backwards teeth

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 24
teeth: mode bmc
teeth: depth 24
teeth: expect fail

[engines]
smtbmc boolector

[script]
read_verilog engine.v
hierarchy -top engine_top
proc
flatten
cd engine_top
expose w:solo.engine.completes
rename solo.engine.completes eng_completes
cd ..
jump_in_one: read -define JUMP_IN_ONE
late_wait_waits: read -define LATE_WAIT_WAITS
no_carry: read -define NO_CARRY
one_late_cycle_is_safe: read -define ONE_LATE_CYCLE_IS_SAFE
taken_backwards: read -define TAKEN_BACKWARDS
read_verilog kernel_step.v
read_verilog -formal -sv phase_step.sv
prep -top phase_step

[files]
engine.v
kernel_step.v
phase_step.sv
