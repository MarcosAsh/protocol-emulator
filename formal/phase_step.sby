[tasks]
prove
cover
narrow_timer_prove narrow_timer
narrow_timer_cover narrow_timer
saturating_narrow narrow_timer saturating
saturating_chip saturating
jump_in_one teeth
late_wait_waits teeth
no_carry teeth
one_late_cycle_is_safe teeth
taken_backwards teeth
second_edge teeth
level_at_arm teeth
later_edge_captured teeth
capture_a_cycle_older teeth
capture_a_cycle_younger teeth
capture_stamped_early teeth
arm_one_short teeth
edge_one_short teeth

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 24
narrow_timer_prove: mode prove
narrow_timer_prove: depth 8
narrow_timer_cover: mode cover
narrow_timer_cover: depth 24
saturating: mode bmc
saturating: depth 136
saturating: skip 135
saturating_narrow: expect fail
teeth: mode bmc
teeth: depth 24
teeth: expect fail

[engines]
smtbmc boolector

[script]
~capture_stamped_early: read_verilog engine.v
capture_stamped_early: read_verilog engine_early.v
hierarchy -top engine
proc
flatten
cd engine
expose w:jmp_go w:advance w:sample w:captured w:out_value w:mov_value
rename jmp_go eng_jmp_go
rename advance eng_advance
rename sample eng_sample
rename captured eng_captured
rename out_value eng_out_value
rename mov_value eng_mov_value
cd ..
jump_in_one: read -define JUMP_IN_ONE
late_wait_waits: read -define LATE_WAIT_WAITS
no_carry: read -define NO_CARRY
one_late_cycle_is_safe: read -define ONE_LATE_CYCLE_IS_SAFE
taken_backwards: read -define TAKEN_BACKWARDS
second_edge: read -define SECOND_EDGE
level_at_arm: read -define LEVEL_AT_ARM
later_edge_captured: read -define LATER_EDGE_CAPTURED
capture_a_cycle_older: read -define CAPTURE_A_CYCLE_OLDER
capture_a_cycle_younger: read -define CAPTURE_A_CYCLE_YOUNGER
capture_stamped_early: read -define CAPTURE_STAMPED_EARLY
arm_one_short: read -define ARM_ONE_SHORT
edge_one_short: read -define EDGE_ONE_SHORT
narrow_timer: read -define TIMER_BITS=7
saturating: read -define ONE_RUN
read_verilog kernel_step.v
read_verilog -formal -sv phase_step.sv
prep -top phase_step

[files]
~saturating:
~narrow_timer: engine.v
narrow_timer: engine.v engine_narrow.v
--
saturating:
~narrow_timer: engine.v engine_saturating.v
narrow_timer: engine.v engine_narrow_saturating.v
--
~narrow_timer: kernel_step.v
narrow_timer: kernel_step.v kernel_step_narrow.v
phase_step.sv
capture_stamped_early: engine_early.v phase_step_teeth/capture_early.v
