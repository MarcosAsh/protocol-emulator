[tasks]
prove
cover
pins_never_change teeth
side_set_only teeth
one_cycle_later teeth
flip_off_issue teeth
no_flip teeth

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 12
teeth: mode bmc
teeth: depth 12
teeth: expect fail

[engines]
smtbmc boolector

[script]
read_verilog engine.v
hierarchy -top engine
proc
flatten
cd engine
expose w:jmp_go w:advance w:out_value w:mov_value
rename jmp_go eng_jmp_go
rename advance eng_advance
rename out_value eng_out_value
rename mov_value eng_mov_value
cd ..
pins_never_change: read -define PINS_NEVER_CHANGE
side_set_only: read -define SIDE_SET_ONLY
one_cycle_later: read -define ONE_CYCLE_LATER
flip_off_issue: read -define FLIP_OFF_ISSUE
no_flip: read -define NO_FLIP
read_verilog -formal -sv edge_step.sv
prep -top edge_step

[files]
engine.v
edge_step.sv
