# The miter of miter.ys, the chip as written against gate.il, for anystate.awk to start
# from any state, which names the written side gold.

read_rtlil written.il
rename written gold
read_rtlil gate.il
miter -equiv -flatten gold gate miter
hierarchy -top miter
delete t:$scopeinfo
script ../netlist_equiv/fine.ys
write_rtlil anystate_pre.il
