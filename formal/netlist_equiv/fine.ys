# Takes a flattened miter down to single-bit cells for anystate.awk. Every flop stays a
# cell of its own and each net keeps all its names, so there is no opt_clean (it would drop
# them). Every flop starts free (anystate.awk), so no initial value is kept.

dffunmap
# both Both_edges' falling pairs (the frame pad's and D-'s, on each side) are the only
# falling flops (see miter.ys and gate.ys, whose clk inverters the miter folds into the
# netlist's). They step with the others, as in the AIG.
select -set falling t:$dff t:$adff %u r:CLK_POLARITY=0 r:CLK_POLARITY=1'0 %u %i
select -assert-count 8 @falling
setparam -set CLK_POLARITY 1 @falling
check -assert
setundef -undriven -anyseq
setattr -unset init
techmap
# rising-edge flops only, with or without an asynchronous reset, which is all anystate.awk handles
select -assert-none t:$_*FF* t:$_*LATCH* t:$_SR_* %u %u t:$_DFF_P_ t:$_DFF_P??_ %u %d
