# A flattened miter down to single-bit cells for anystate.awk, every flop still a cell of
# its own and each net still under all its names: no opt_clean, which would drop them.
# Every flop starts free (anystate.awk), so no initial value is kept.

dffunmap
# both Both_edges' falling pairs, the frame pad's and D-'s, on each side, the only falling
# flops (miter.ys, gate.ys, whose inverters of clk the miter folds into the netlist's), step
# with the others, as in the AIG
select -set falling t:$dff t:$adff %u r:CLK_POLARITY=0 r:CLK_POLARITY=1'0 %u %i
select -assert-count 8 @falling
setparam -set CLK_POLARITY 1 @falling
check -assert
setundef -undriven -anyseq
setattr -unset init
techmap
# rising-edge flops only, with or without an asynchronous reset: what anystate.awk handles
select -assert-none t:$_*FF* t:$_*LATCH* t:$_SR_* %u %u t:$_DFF_P_ t:$_DFF_P??_ %u %d
