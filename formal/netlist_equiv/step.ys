# gold.il against the chip as written, from written.v, the copy of src/protocol_emulator.v
# the Makefile makes, so a tooth can mutate this side alone. The recoded machines power up
# all 0, which is no state, so the two sides' flops match only after the first cycle: the
# Makefile checks that cycle by BMC and proves the rest from every state it reaches.

read_verilog ../../src/project.v written.v
read_verilog -lib ../../src/RM_IHPSG13_1P_512x16_c2_bm_bist.v
hierarchy -check -top tt_um_marcosash_protocol_emulator
proc
script ../netlist_equiv/cut.ys
rename tt_um_marcosash_protocol_emulator written
hierarchy -top written
delete =A:blackbox

read_rtlil gold.il
miter -equiv -flatten gold written chip_step
hierarchy -top chip_step
delete t:$scopeinfo
script ../netlist_equiv/aig.ys
select -assert-none t:$anyseq t:$anyconst %u
write_aiger chip_step.aig
