# The reference side: src/project.v around src/protocol_emulator.v, as the flow reads it,
# with the three macros cut (cut.ys). Synthesis recodes the state machines to one-hot,
# which no signal correspondence can match, so gold.il carries them recoded the way the
# flow recodes them, and step.ys proves gold.il equal to the chip as written.

read_verilog ../../src/project.v ../../src/protocol_emulator.v
read_verilog -lib ../../src/RM_IHPSG13_1P_512x16_c2_bm_bist.v
hierarchy -check -top tt_um_marcosash_protocol_emulator
proc

# the host port's state machine and the load checker's three are the only ones the RTL
# marks for recoding
select -assert-count 4 a:fsm_encoding
select -assert-count 1 host_port/a:fsm_encoding
select -assert-count 3 load_checker/a:fsm_encoding
flatten host_port
opt_expr host_port load_checker
opt_clean host_port load_checker
opt -nodffe -nosdff host_port load_checker
fsm host_port load_checker
opt host_port load_checker

script ../netlist_equiv/cut.ys
rename tt_um_marcosash_protocol_emulator gold
hierarchy -top gold
delete =A:blackbox
write_rtlil gold.il
